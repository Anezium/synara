+impl Drop for FetchPool {
+    fn drop(&mut self) {
+        // Closing every job channel ends each worker's recv loop.
+        self.job_txs.clear();
+        for worker in self.workers.drain(..) {
+            let _ = worker.join();
+        }
+    }
