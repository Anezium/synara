+#[link(name = "Carbon", kind = "framework")]
+extern "C" {
+    fn IsSecureEventInputEnabled() -> u8;
+}
+
+/// AXRole values from the target app's focused element outward, innermost
+/// first and bounded like the selection-ancestor walk. Read-only AX facts; a
+/// missing element or attribute ends the chain as inconclusive.
+fn focused_ancestor_roles(pid: i32) -> Vec<String> {
+    const MAX_FOCUS_ANCESTORS: usize = 8;
+    let mut roles = Vec::new();
+    unsafe {
+        let app = AXUIElementCreateApplication(pid);
+        if app.is_null() {
+            return roles;
+        }
+        let mut current = copy_element_attr(app, "AXFocusedUIElement");
+        CFRelease(app as CFTypeRef);
+        for _ in 0..MAX_FOCUS_ANCESTORS {
+            let Some(element) = current.take() else {
+                break;
+            };
+            roles.push(copy_string_attr(element, "AXRole").unwrap_or_default());
+            current = copy_element_attr(element, "AXParent");
+            CFRelease(element as CFTypeRef);
+        }
+        if let Some(element) = current.take() {
+            CFRelease(element as CFTypeRef);
+        }
+    }
+    roles
+}
+
+/// Pure decision core for the modal-sheet guard: refuse when focus sits inside
+/// a sheet before reaching the enclosing window or application. Only positive
+/// detection refuses; an inconclusive chain never blocks an unrelated action.
+fn focused_sheet_refusal(
+    pid: i32,
+    window_id: u32,
+    ancestor_roles: &[&str],
+) -> Option<TargetRefusal> {
+    for role in ancestor_roles {
+        if *role == "AXSheet" {
+            return Some(TargetRefusal::new(
+                "auth_sheet_focused",
+                "The target app has a modal sheet holding focus. Dismiss the sheet or focus the target window and retry; nothing was sent.",
+                pid,
+                window_id,
+            ));
+        }
+        if *role == "AXWindow" || *role == "AXApplication" {
+            break;
+        }
+    }
+    None
+}
+
+fn install_space_observer() {
+    static ONCE: Once = Once::new();
+    ONCE.call_once(|| {
+        use block2::RcBlock;
+        use objc2_app_kit::{NSWorkspace, NSWorkspaceActiveSpaceDidChangeNotification};
+        use objc2_foundation::{NSNotification, NSOperationQueue};
+        use std::ptr::NonNull;
+        let workspace = unsafe { NSWorkspace::sharedWorkspace() };
+        let center = unsafe { workspace.notificationCenter() };
+        let queue = unsafe { NSOperationQueue::new() };
+        unsafe { queue.setMaxConcurrentOperationCount(1) };
+        let block = RcBlock::new(|_: NonNull<NSNotification>| {
+            SPACE_EPOCH.fetch_add(1, Ordering::AcqRel);
+            super::cancellation::gate().target_space_changed();
+        });
+        let token = unsafe {
+            center.addObserverForName_object_queue_usingBlock(
+                Some(NSWorkspaceActiveSpaceDidChangeNotification),
+                None,
+                Some(&queue),
+                &block,
+            )
+        };
+        // Process-lifetime observer, matching the existing activation observer.
+        std::mem::forget(token);
+        std::mem::forget(queue);
+    });
+}
