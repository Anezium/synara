+//! Compact pointer based on the black arrow / white outline in Computer Use's
+//! SoftwareCursor artwork. Drawn as a vector at the actual input hotspot, with
+//! no badge from the source asset and no theme morph, rotation, or click bounce.
+
+use std::sync::OnceLock;
+use tiny_skia::{Color, FillRule, Paint, Path, PathBuilder, Pixmap, Stroke, Transform};
+
+fn arrow() -> &'static Path {
+    static PATH: OnceLock<Path> = OnceLock::new();
+    PATH.get_or_init(|| {
+        let mut p = PathBuilder::new();
+        p.move_to(0.0, 0.0);
+        p.line_to(0.0, 23.0);
+        p.line_to(6.0, 17.5);
+        p.line_to(11.0, 28.0);
+        p.line_to(15.0, 26.0);
+        p.line_to(10.0, 16.0);
+        p.line_to(18.5, 16.0);
+        p.close();
+        p.finish().expect("static compact cursor path")
+    })
+}
+
+pub fn paint(pm: &mut Pixmap, x: f32, y: f32, scale: f32, alpha: f32, pressed: bool) {
+    let transform = Transform::from_row(scale, 0.0, 0.0, scale, x, y);
+    let outline = Paint {
+        shader: tiny_skia::Shader::SolidColor(Color::from_rgba(1.0, 1.0, 1.0, alpha).unwrap()),
+        anti_alias: true,
+        ..Default::default()
+    };
+    pm.stroke_path(
+        arrow(),
+        &outline,
+        &Stroke {
+            width: 2.4,
+            line_join: tiny_skia::LineJoin::Round,
+            ..Default::default()
+        },
+        transform,
+        None,
+    );
+    let shade = if pressed { 0.25 } else { 0.06 };
+    let fill = Paint {
+        shader: tiny_skia::Shader::SolidColor(
+            Color::from_rgba(shade, shade, shade, alpha).unwrap(),
+        ),
+        anti_alias: true,
+        ..Default::default()
+    };
+    pm.fill_path(arrow(), &fill, FillRule::Winding, transform, None);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{CursorAction, CursorConfig, OverlayCommand, RenderStateCore};
+
+    fn compact() -> RenderStateCore {
+        RenderStateCore::new(CursorConfig {
+            compact: true,
+            ..CursorConfig::default()
+        })
+    }
+
+    #[test]
+    fn compact_moves_and_clicks_use_exact_hotspot_without_a_path_or_pulse() {
+        let mut c = compact();
+        for (x, y) in [(20.0, 30.0), (1900.0, 100.0), (3.0, 4.0)] {
+            c.apply_command_base(
+                OverlayCommand::MoveTo {
+                    x,
+                    y,
+                    end_heading_radians: 2.0,
+                },
+                true,
+                true,
+            );
+            assert_eq!(c.pos, (x, y));
+            assert!(c.path.is_none());
+            c.apply_command_base(OverlayCommand::ClickPulse { x, y }, true, true);
+            assert_eq!(c.pos, (x, y));
+            assert!(c.click_t.is_none());
+            assert!(c.spring.is_none());
+        }
+    }
+
+    #[test]
+    fn compact_artwork_is_stable_across_actions_heading_and_time() {
+        let mut c = compact();
+        c.pos = (16.0, 16.0);
+        let mut baseline = Pixmap::new(128, 128).unwrap();
+        crate::paint_cursor(&mut baseline, &c, 0.0, 0.0, None, 2.0);
+        assert!(baseline.pixels().iter().any(|p| p.alpha() != 0));
+        for action in [
+            CursorAction::Click,
+            CursorAction::Navigate,
+            CursorAction::Text,
+            CursorAction::Scroll,
+        ] {
+            c.visual.begin(action, None, None);
+            c.visual.tick(0.15);
+            c.heading = 2.8;
+            let mut frame = Pixmap::new(128, 128).unwrap();
+            crate::paint_cursor(&mut frame, &c, 0.0, 0.0, None, 2.0);
+            assert_eq!(baseline.data(), frame.data());
+        }
+        if let Ok(path) = std::env::var("SYNARA_CURSOR_PREVIEW_PATH") {
+            image::save_buffer(path, baseline.data(), 128, 128, image::ColorType::Rgba8).unwrap();
+        }
+    }
+
+    #[test]
+    fn compact_hidden_pointer_has_no_pixels_or_hover_poll() {
+        let mut c = compact();
+        c.pos = (16.0, 16.0);
+        c.apply_command_base(OverlayCommand::SetSessionLabel("Synara".into()), true, true);
+        assert!(!c.session_badge_needs_hover_poll());
+        c.apply_command_base(OverlayCommand::SetEnabled(false), true, true);
+        let mut frame = Pixmap::new(128, 128).unwrap();
+        crate::paint_cursor(&mut frame, &c, 0.0, 0.0, None, 2.0);
+        assert!(frame.pixels().iter().all(|p| p.alpha() == 0));
+    }
+}
